(function(window,document){'use strict';if(window.__pageDiagnosticsRan){return}
window.__pageDiagnosticsRan=!0;var config=window.wlrsdConsole||{};function num(value,fallback){var n=typeof value==='number'?value:parseInt(value,10);return isNaN(n)?fallback:n}
var TITLE_MIN=num(config.titleMin,50);var TITLE_MAX=num(config.titleMax,60);var META_MIN=num(config.metaMin,150);var META_MAX=num(config.metaMax,160);var CWV_THRESHOLDS={LCP:{good:2500,poor:4000,unit:'ms'},CLS:{good:0.1,poor:0.25,unit:''},INP:{good:200,poor:500,unit:'ms'},FCP:{good:1800,poor:3000,unit:'ms'},TTFB:{good:800,poor:1800,unit:'ms'}};function safe(fn,fallback){try{return fn()}catch(e){return fallback}}
function rate(metric,value){if(value===null||typeof value==='undefined'||isNaN(value)){return null}
var t=CWV_THRESHOLDS[metric];if(!t){return null}
if(value<=t.good){return'good'}
if(value>=t.poor){return'poor'}
return'needs improvement'}
function fmt(metric,value){if(value===null||typeof value==='undefined'||isNaN(value)){return'n/a'}
var t=CWV_THRESHOLDS[metric]||{unit:''};if(metric==='CLS'){return value.toFixed(3)}
return Math.round(value)+t.unit}
function getMetaContent(selectors){for(var i=0;i<selectors.length;i++){var el=document.querySelector(selectors[i]);if(el){var content=el.getAttribute('content');if(content){return content}}}
return''}
function getIndexation(){var robots=getMetaContent(['meta[name="robots" i]']).toLowerCase();var googlebot=getMetaContent(['meta[name="googlebot" i]']).toLowerCase();var combined=robots+' '+googlebot;var isNoindex=combined.indexOf('noindex')!==-1;return{status:isNoindex?'NOINDEX':'INDEXABLE',raw:robots||googlebot||'(none)'}}
function getHeadingCounts(){return{h1:document.querySelectorAll('h1').length,h2:document.querySelectorAll('h2').length}}
function getTitle(){var text=document.title||'';return{text:text,len:text.length}}
function getMetaDescription(){var text=getMetaContent(['meta[name="description" i]']);return{text:text,len:text.length}}
function getCanonical(){var el=document.querySelector('link[rel="canonical" i]');return el&&el.getAttribute('href')?el.getAttribute('href'):'none'}
function passWarn(ok){return ok?'PASS':'WARN'}
function collectPerformance(callback){var metrics={TTFB:null,FCP:null,LCP:null,CLS:null,INP:null};safe(function(){if(window.performance&&typeof window.performance.getEntriesByType==='function'){var navEntries=window.performance.getEntriesByType('navigation');if(navEntries&&navEntries.length&&typeof navEntries[0].responseStart==='number'){metrics.TTFB=navEntries[0].responseStart}else if(window.performance.timing){var timing=window.performance.timing;if(timing.responseStart&&timing.navigationStart){metrics.TTFB=timing.responseStart-timing.navigationStart}}}});safe(function(){if(window.performance&&typeof window.performance.getEntriesByType==='function'){var paintEntries=window.performance.getEntriesByType('paint');for(var i=0;i<paintEntries.length;i++){if(paintEntries[i].name==='first-contentful-paint'){metrics.FCP=paintEntries[i].startTime}}}});var hasPO=typeof window.PerformanceObserver!=='undefined';var lcpDone=!hasPO;var clsDone=!hasPO;var inpDone=!hasPO;function maybeFinish(){if(lcpDone&&clsDone&&inpDone){callback(metrics)}}
if(!hasPO){maybeFinish();return}
safe(function(){var lcpObserver=new PerformanceObserver(function(list){var entries=list.getEntries();if(entries.length){metrics.LCP=entries[entries.length-1].startTime}});lcpObserver.observe({type:'largest-contentful-paint',buffered:!0})},null);safe(function(){var clsValue=0;var clsObserver=new PerformanceObserver(function(list){list.getEntries().forEach(function(entry){if(!entry.hadRecentInput){clsValue+=entry.value}});metrics.CLS=clsValue});clsObserver.observe({type:'layout-shift',buffered:!0});if(metrics.CLS===null){metrics.CLS=0}},null);safe(function(){var inpObserver=new PerformanceObserver(function(list){list.getEntries().forEach(function(entry){var duration=entry.duration;if(typeof duration==='number'&&(metrics.INP===null||duration>metrics.INP)){metrics.INP=duration}})});inpObserver.observe({type:'event',buffered:!0,durationThreshold:40})},null);safe(function(){var firstInputObserver=new PerformanceObserver(function(list){var entries=list.getEntries();if(entries.length&&metrics.INP===null){metrics.INP=entries[0].duration||(entries[0].processingStart-entries[0].startTime)}});firstInputObserver.observe({type:'first-input',buffered:!0})},null);window.setTimeout(function(){callback(metrics)},1500)}
function printReport(metrics){var groupStyle='color:#1a53d0;font-weight:bold;';var passStyle='color:#067647;font-weight:bold;';var warnStyle='color:#b54708;font-weight:bold;';console.groupCollapsed('%c📋 Page Diagnostics',groupStyle);var indexation=getIndexation();console.log('%cIndexation:%c '+indexation.status+' %c('+indexation.raw+')','font-weight:bold;',indexation.status==='INDEXABLE'?passStyle:warnStyle,'color:inherit;font-weight:normal;');var headings=getHeadingCounts();var h1Ok=headings.h1===1;console.log('%cH1 count:%c '+headings.h1+' ['+passWarn(h1Ok)+']','font-weight:bold;',h1Ok?passStyle:warnStyle);console.log('%cH2 count:%c '+headings.h2,'font-weight:bold;','font-weight:normal;');var title=getTitle();var titleOk=title.len>0&&title.len>=TITLE_MIN&&title.len<=TITLE_MAX;console.log('%cTitle ('+title.len+' chars, expected '+TITLE_MIN+'–'+TITLE_MAX+'):%c ['+passWarn(titleOk)+']\n'+title.text,'font-weight:bold;',titleOk?passStyle:warnStyle);var meta=getMetaDescription();var metaOk=meta.len>0&&meta.len>=META_MIN&&meta.len<=META_MAX;console.log('%cMeta description ('+meta.len+' chars, expected '+META_MIN+'–'+META_MAX+'):%c ['+passWarn(metaOk)+']\n'+(meta.text||'(none)'),'font-weight:bold;',metaOk?passStyle:warnStyle);console.log('%cCanonical URL:%c '+getCanonical(),'font-weight:bold;','font-weight:normal;');var rows=[];['TTFB','FCP','LCP','CLS','INP'].forEach(function(metric){var value=metrics[metric];rows.push({Metric:metric,Value:fmt(metric,value),Rating:rate(metric,value)||'n/a'})});console.log('%cCore Web Vitals:','font-weight:bold;');if(typeof console.table==='function'){console.table(rows)}else{rows.forEach(function(row){console.log(row.Metric+': '+row.Value+' ('+row.Rating+')')})}
console.groupEnd()}
function run(){safe(function(){collectPerformance(function(metrics){printReport(metrics)})})}
if(document.readyState==='complete'){window.setTimeout(run,300)}else{window.addEventListener('load',function(){window.setTimeout(run,300)})}})(window,document)